#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_box3d = env_modules.Clone()

# Thirdparty source files

thirdparty_dir = "#thirdparty/box3d/"
thirdparty_sources = [
    "src/aabb.c",
    "src/arena_allocator.c",
    "src/bitset.c",
    "src/block_allocator.c",
    "src/body.c",
    "src/broad_phase.c",
    "src/capsule.c",
    "src/compound.c",
    "src/constraint_graph.c",
    "src/contact.c",
    "src/contact_solver.c",
    "src/convex_manifold.c",
    "src/core.c",
    "src/distance.c",
    "src/distance_joint.c",
    "src/dynamic_tree.c",
    "src/height_field.c",
    "src/hull.c",
    "src/id_pool.c",
    "src/island.c",
    "src/joint.c",
    "src/manifold.c",
    "src/math_functions.c",
    "src/mesh.c",
    "src/mesh_contact.c",
    "src/motor_joint.c",
    "src/mover.c",
    "src/name_cache.c",
    "src/parallel_for.c",
    "src/parallel_joint.c",
    "src/physics_world.c",
    "src/prismatic_joint.c",
    "src/recording.c",
    "src/recording_replay.c",
    "src/revolute_joint.c",
    "src/scheduler.c",
    "src/sensor.c",
    "src/shape.c",
    "src/simd.c",
    "src/solver.c",
    "src/solver_set.c",
    "src/sphere.c",
    "src/spherical_joint.c",
    "src/table.c",
    "src/timer.c",
    "src/triangle_manifold.c",
    "src/types.c",
    "src/weld_joint.c",
    "src/wheel_joint.c",
    "src/world_snapshot.c",
]

thirdparty_sources = [thirdparty_dir + file for file in thirdparty_sources]

env_box3d.Prepend(CPPPATH=[thirdparty_dir + "include", thirdparty_dir + "src"])

env_thirdparty = env_box3d.Clone()
env_thirdparty.disable_warnings()

# Box3D is C17 and relies on strict IEEE float behavior for cross-platform determinism.
if env.msvc:
    env_thirdparty.Append(CFLAGS=["/std:c17"])
else:
    env_thirdparty.Append(CFLAGS=["-std=gnu17", "-ffp-contract=off"])

if env["precision"] == "double":
    env_box3d.Append(CPPDEFINES=["BOX3D_DOUBLE_PRECISION"])
    env_thirdparty.Append(CPPDEFINES=["BOX3D_DOUBLE_PRECISION"])

if env["platform"] == "web":
    if env["wasm_simd"]:
        # Box3D maps its WebAssembly path onto SSE2, which Emscripten only exposes with these flags.
        env_thirdparty.Append(CFLAGS=["-msimd128", "-msse2"])
    else:
        env_box3d.Append(CPPDEFINES=["BOX3D_DISABLE_SIMD"])
        env_thirdparty.Append(CPPDEFINES=["BOX3D_DISABLE_SIMD"])

thirdparty_obj = []
env_thirdparty.add_source_files(thirdparty_obj, thirdparty_sources)
env.modules_sources += thirdparty_obj

# Godot source files

module_obj = []

env_box3d.add_source_files(module_obj, "*.cpp")
env_box3d.add_source_files(module_obj, "joints/*.cpp")
env_box3d.add_source_files(module_obj, "misc/*.cpp")
env_box3d.add_source_files(module_obj, "objects/*.cpp")
env_box3d.add_source_files(module_obj, "shapes/*.cpp")
env_box3d.add_source_files(module_obj, "spaces/*.cpp")
env.modules_sources += module_obj

# Needed to force rebuilding the module files when the thirdparty library is updated.
env.Depends(module_obj, thirdparty_obj)
