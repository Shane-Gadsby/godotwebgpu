< 		// IMPORTANT (found the hard way): on WebGPU, the engine's first rendered
< 		// frame runs *synchronously inside* the WASM callMain() call -- after
< 		// `engine.startGame()`'s download/init work is done, but before its
< 		// promise resolves, before control ever returns to JS, and therefore
< 		// before the browser gets a chance to paint anything. On a cold shader
< 		// cache this single call can block the main thread for many seconds
< 		// (SPIR-V -> WGSL conversion for every specialized pipeline variant the
< 		// first frame needs; see webgpu_notes/TASKS.md §4.21 and Section 10
< 		// of webgpu_notes/TASKS.md §4.21). No JS-side progress text
< 		// or event listener can update the screen during that window -- the JS
< 		// thread that would run them is the same one that's blocked. Two
< 		// consequences, both handled below:
< 		//
< 		// 1. `engine.js`'s start() dispatches 'godot-before-callmain' right
< 		//    before that call and yields two animation frames first -- we use
< 		//    that instant (not, e.g., before startGame() is even called, which
< 		//    would show this notice before the download has even started) to
< 		//    show a "please wait, this can take a while" notice, so it's
< 		//    actually painted before the long synchronous call begins. Without
< 		//    that yield, DOM changes made here would be queued but never
< 		//    painted until *after* the block -- defeating the point.
< 		// 2. That notice needs a spinner driven by CSS animation only (see the
< 		//    #webgpu-spinner rule above), since a compositor-thread animation on
< 		//    `transform` keeps running even while the main JS thread is blocked
< 		//    -- it's the only feedback that can actually be seen during the
< 		//    stall itself, as opposed to before or after it.
< 		//
< 		// Separately, later frames (after the first) run one-per-requestAnimationFrame,
< 		// so the browser *does* get control back between them even if any one of
< 		// them individually blocks for a while recompiling further shaders --
< 		// hence still listening for the driver's per-compile signal and waiting
< 		// for a quiet period below, to keep the notice accurate for that tail.
< 		let firstFramePresented = false;
< 		let shaderCompileCount = 0;
< 		let lastShaderCompileTime = 0;
< 		// Set once the engine is about to run. The preloader can still report a
< 		// final progress callback after that point, and it must not pull the
< 		// text back to the download stage once "Starting engine" is on screen.
< 		let engineStarting = false;
< 		if (GODOT_RENDERING_DRIVER === 'webgpu') {
< 			window.addEventListener('godot-before-callmain', () => {
< 				engineStarting = true;
< 				showBusyStage('starting_engine');
< 			});
< 			window.addEventListener('godot-webgpu-first-frame', () => {
< 				firstFramePresented = true;
< 			});
< 			window.addEventListener('godot-webgpu-shader-compile', (event) => {
