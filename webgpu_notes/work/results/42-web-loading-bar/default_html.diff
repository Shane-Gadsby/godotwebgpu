> /* The export preset's progress bar colors (loading_screen/progress_bar/*), set
>    as custom properties by the script below because inline styles cannot reach
>    the pseudo-elements that draw a <progress>. Only added when a color differs
>    from its default; otherwise the bar keeps the browser's native look. */
> #status-progress.custom-colors {
> 	-webkit-appearance: none;
> 	appearance: none;
> 	box-sizing: border-box;
> 	height: 1rem;
> 	border: 1px solid var(--progress-border-color);
> 	border-radius: 0.5rem;
> 	background-color: var(--progress-background-color);
> 	overflow: hidden;
> }
> 
> #status-progress.custom-colors::-webkit-progress-bar {
> 	background-color: transparent;
> }
> 
> #status-progress.custom-colors::-webkit-progress-value {
> 	background-color: var(--progress-fill-color);
> }
> 
> #status-progress.custom-colors::-moz-progress-bar {
> 	background-color: var(--progress-fill-color);
> }
> 
> /* No value yet (download size unknown): a block of the fill color sweeps
>    across, as the native indeterminate bar does. */
> #status-progress.custom-colors:indeterminate {
> 	background-image: linear-gradient(var(--progress-fill-color), var(--progress-fill-color));
> 	background-repeat: no-repeat;
> 	background-size: 30% 100%;
> 	animation: status-progress-indeterminate 1.5s linear infinite;
> }
> 
> #status-progress.custom-colors:indeterminate::-moz-progress-bar {
> 	background-color: transparent;
> }
> 
> @keyframes status-progress-indeterminate {
> 	from { background-position: -50% 0; }
> 	to { background-position: 150% 0; }
> }
