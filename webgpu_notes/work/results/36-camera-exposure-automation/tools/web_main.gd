extends Node3D
# Web copy of proj/meter_test.gd (generated by make_web.py): the same scenes, configured from the URL query.
# Sets document.title to "ready" after frames=N frames (default 12).

var args := {}
var frames := 0
const RESERVED := ["res", "scene", "out", "frames", "caps", "hdr", "attrs", "light", "exposure", "maxfps"]

func _parse_value(v: String):
	if v == "true":
		return true
	if v == "false":
		return false
	if v.contains(","):
		var p := v.split(",")
		return Vector2(float(p[0]), float(p[1]))
	if v.is_valid_int():
		return int(v)
	return float(v)

var gradient_shader: Shader

# A rectangle in frame units (x right, y down, the frame height = 1), unshaded, linear value v0 at the top to v1 at the
# bottom (geometric), times tint.
func _rect(root3d: Node3D, aspect: float, r: Rect2, z: float, v0: float, v1: float, tint := Color(1, 1, 1)):
	var mi := MeshInstance3D.new()
	var q := QuadMesh.new()
	q.size = r.size
	mi.mesh = q
	var m := ShaderMaterial.new()
	m.shader = gradient_shader
	m.set_shader_parameter("v0", v0)
	m.set_shader_parameter("v1", v1)
	m.set_shader_parameter("tint", Vector3(tint.r, tint.g, tint.b))
	mi.material_override = m
	var c := r.get_center()
	mi.position = Vector3(c.x - 0.5 * aspect, 0.5 - c.y, z)
	root3d.add_child(mi)

func _ready():
	var query: String = str(JavaScriptBridge.eval("location.search")).trim_prefix("?")
	for a in query.split("&", false):
		var kv := a.split("=", true, 1)
		if kv.size() == 2:
			args[kv[0]] = kv[1].uri_decode()
	gradient_shader = Shader.new()
	gradient_shader.code = """
shader_type spatial;
render_mode unshaded;
uniform float v0;
uniform float v1;
uniform vec3 tint;
void fragment() {
	ALBEDO = tint * v0 * pow(v1 / v0, UV.y);
}
"""
	var root3d := Node3D.new()
	var cam := Camera3D.new()
	root3d.add_child(cam)
	var env := WorldEnvironment.new()
	var e := Environment.new()
	e.background_mode = Environment.BG_COLOR
	e.background_color = Color(0, 0, 0)
	e.tonemap_mode = Environment.TONE_MAPPER_LINEAR
	e.tonemap_exposure = float(args.get("exposure", "1.0"))
	env.environment = e
	root3d.add_child(env)

	# The window does not have its final size yet here: r.sh passes the --resolution as res=WxH.
	var res := String(args.get("res", "1920x1080")).split("x")
	var aspect := float(res[0]) / float(res[1])
	var scene: String = args.get("scene", "meter")
	if scene == "meter":
		# A dark interior with a bright window at the upper right, a mid-gray subject in the middle and a few tiny,
		# very bright lamps. Orthographic, so every rectangle maps to known pixels.
		cam.projection = Camera3D.PROJECTION_ORTHOGONAL
		cam.size = 1.0
		cam.position = Vector3(0, 0, 5)
		_rect(root3d, aspect, Rect2(0, 0, aspect, 1), 0.0, 0.01, 0.06) # interior: 0.01 at the top to 0.06 at the floor
		_rect(root3d, aspect, Rect2(1.1, 0.1, 0.5, 0.5), 0.1, 12.0, 2.0) # window: sky 12 to 2
		_rect(root3d, aspect, Rect2(0.5 * aspect - 0.2, 0.3, 0.4, 0.4), 0.1, 0.1, 0.3) # subject around 0.18
		for i in 4:
			_rect(root3d, aspect, Rect2(0.15 + 0.12 * i, 0.08, 0.03, 0.03), 0.2, 40.0, 200.0) # lamps
	elif scene == "awb":
		# A room lit by one light (light=<r,g,b> linear, default a 3200 K blackbody) with a gray card, white walls and
		# colored objects, under the default manual white balance (6500 K).
		e.ambient_light_source = Environment.AMBIENT_SOURCE_DISABLED
		e.reflected_light_source = Environment.REFLECTION_SOURCE_DISABLED
		cam.position = Vector3(0, 1.2, 4.0)
		cam.rotation_degrees = Vector3(-8, 0, 0)
		var light := OmniLight3D.new()
		var lc := String(args.get("light", "1.0,0.5156653,0.19401851")).split(",")
		light.light_color = Color(float(lc[0]), float(lc[1]), float(lc[2])).linear_to_srgb()
		light.omni_range = 20.0
		light.omni_attenuation = 0.0
		light.light_energy = 1.0
		light.position = Vector3(0.5, 2.6, 2.5)
		root3d.add_child(light)
		var dir := DirectionalLight3D.new()
		dir.light_color = light.light_color
		dir.light_energy = 0.6
		dir.rotation_degrees = Vector3(-40, 25, 0)
		root3d.add_child(dir)
		var mk := func(mesh: Mesh, pos: Vector3, col: Color, rot := Vector3()):
			var mi := MeshInstance3D.new()
			mi.mesh = mesh
			var m := StandardMaterial3D.new()
			m.albedo_color = col
			m.roughness = 1.0
			m.metallic_specular = 0.0
			mi.material_override = m
			mi.position = pos
			mi.rotation_degrees = rot
			root3d.add_child(mi)
		var floor_mesh := PlaneMesh.new()
		floor_mesh.size = Vector2(12, 12)
		mk.call(floor_mesh, Vector3(0, 0, 0), Color(0.55, 0.55, 0.55))
		var wall := PlaneMesh.new()
		wall.size = Vector2(12, 6)
		mk.call(wall, Vector3(0, 3, -3), Color(0.8, 0.8, 0.8), Vector3(90, 0, 0))
		var card := BoxMesh.new()
		card.size = Vector3(0.9, 0.9, 0.02)
		mk.call(card, Vector3(0, 1.2, 0.5), Color(0.5, 0.5, 0.5), Vector3(0, 0, 0))
		var box := BoxMesh.new()
		box.size = Vector3(0.8, 0.8, 0.8)
		mk.call(box, Vector3(-1.8, 0.4, 0.0), Color(0.75, 0.08, 0.06), Vector3(0, 30, 0))
		mk.call(box, Vector3(1.8, 0.4, -0.3), Color(0.06, 0.15, 0.7), Vector3(0, -20, 0))
		var sphere := SphereMesh.new()
		mk.call(sphere, Vector3(-1.2, 0.5, 0.6), Color(0.1, 0.6, 0.12))
		mk.call(sphere, Vector3(1.1, 0.5, 0.9), Color(0.85, 0.7, 0.1))
	elif scene == "default":
		# Lights, shadows, sky and glow, for the bit-identical check.
		e.background_mode = Environment.BG_SKY
		e.sky = Sky.new()
		e.sky.sky_material = ProceduralSkyMaterial.new()
		e.tonemap_mode = Environment.TONE_MAPPER_FILMIC
		e.glow_enabled = true
		var light := DirectionalLight3D.new()
		light.rotation_degrees = Vector3(-50, 30, 0)
		light.shadow_enabled = true
		root3d.add_child(light)
		for i in 5:
			var mi := MeshInstance3D.new()
			mi.mesh = SphereMesh.new()
			mi.position = Vector3(i * 1.5 - 3.0, 0, -6.0)
			var m := StandardMaterial3D.new()
			m.albedo_color = Color.from_hsv(i / 5.0, 0.7, 0.9)
			m.emission_enabled = i == 2
			m.emission = Color(1, 0.5, 0.2)
			m.emission_energy_multiplier = 4.0
			mi.material_override = m
			root3d.add_child(mi)

	var attrs_kind: String = args.get("attrs", "practical")
	var attrs: CameraAttributes = null
	if attrs_kind == "physical":
		attrs = CameraAttributesPhysical.new()
	elif attrs_kind == "practical":
		attrs = CameraAttributesPractical.new()
	if attrs:
		for k in args:
			if k in RESERVED:
				continue
			attrs.set(k, _parse_value(args[k]))
		cam.attributes = attrs
	add_child(root3d)
	cam.current = true

func _process(_delta):
	frames += 1
	if frames == int(args.get("frames", "12")):
		JavaScriptBridge.eval("document.title = 'ready'")
