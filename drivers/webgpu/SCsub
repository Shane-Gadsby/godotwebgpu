if env["platform"] == "web":
    # Full driver (WEBGPU_ENABLED, set by platform/web/detect.py): everything,
    # including the Emscripten-dependent rendering_device_driver_webgpu.cpp /
    # rendering_context_driver_webgpu.cpp. Exclude spirv_cross_wrapper.cpp
    # from the glob — it's compiled above in the SPIRV-Cross environment
    # (exceptions on) instead. Also exclude wgsl_bake_subprocess.cpp — it's
    # the native-editor-only baker helper below, and doesn't build for web
    # (it shells out to a native wgsl_convert_cli process, meaningless inside
    # the Emscripten sandbox).
    webgpu_sources = Glob("#drivers/webgpu/*.cpp")
    webgpu_sources = [
        f
        for f in webgpu_sources
        if "spirv_cross_wrapper" not in str(f)
        and "wgsl_bake_subprocess" not in str(f)
        and "spirv_opt_passes" not in str(f)
    ]
    env_webgpu.add_source_files(env.drivers_sources, webgpu_sources)

    # spirv_opt_passes.cpp is written against SPIRV-Tools' optimizer IR, whose
    # headers need SPIRV-Tools' internal include paths. It includes no Godot
    # headers, so those paths stay out of the rest of the driver (where bare
    # names like "table.h" could otherwise resolve into SPIRV-Tools), while it
    # keeps the driver's own warning flags.
    env_spirv_opt = env_webgpu.Clone()
    env_spirv_opt.Prepend(
        CPPPATH=[
            spirv_tools_dir,
            spirv_tools_dir + "source/",
            spirv_tools_dir + "generated/",
            spirv_headers_dir + "include/spirv/unified1/",
        ]
    )
    env_spirv_opt.add_source_files(env.drivers_sources, ["#drivers/webgpu/spirv_opt_passes.cpp"])

    # Generate precompiled SPIR-V → WGSL lookup table at build time.
    # The generated header is #included by rendering_device_driver_webgpu.cpp.
    precompiled = env.CommandNoCache(
        "#drivers/webgpu/wgsl_precompiled.gen.h",
        "#drivers/webgpu/wgsl_precompile.py",
        env.Run(wgsl_precompile.build_wgsl_precompiled),
    )
    # The table is the output of the whole SPIR-V -> WGSL pipeline run over the engine's
    # shaders, so it is stale whenever a preprocessing pass or a shader changes, not only
    # when the script does. Without these a pass fix reached runtime-converted shaders but
    # silently not the precompiled engine ones (TASKS.md 2.30). The vendored converter
    # and SPIRV-Tools are covered by the fingerprint below instead.
    pipeline_sources = [
        "#drivers/webgpu/" + f
        for f in (
            "spirv_preprocess.cpp",
            "spirv_preprocess.h",
            "spirv_opt_passes.cpp",
            "spirv_opt_passes.h",
            "spirv_binding_layout.h",
            "spirv_to_wgsl.cpp",
            "spirv_cross_wrapper.cpp",
            "wgsl_cli/main.cpp",
        )
    ]
    # The renderer shaders include FSR 1/2 sources from thirdparty/, so a change
    # confined to those (an amd-fsr2 patch) must re-bake the table too.
    shader_sources = [
        os.path.join(root, f)
        for shader_dir in (
            "#servers/rendering/renderer_rd/shaders",
            "#thirdparty/amd-fsr",
            "#thirdparty/amd-fsr2/shaders",
        )
        for root, _, files in os.walk(env.Dir(shader_dir).abspath)
        for f in files
        if f.endswith((".glsl", ".h"))
    ]
    env.Depends(precompiled, pipeline_sources + shader_sources)

    # Vendored SPIRV-Cross and SPIRV-Tools decide this table's contents just as
    # much as the sources above do, but naming them as dependencies means naming
    # thousands of files -- and the binary that actually does the work,
    # bin/wgsl_convert_cli, is built by wgsl_cli/build.sh from inside the action,
    # so SCons never sees it at all. Fingerprint the lot instead: size+mtime of
    # every vendored/CLI source, the hash of the existing binary (so a
    # hand-rebuilt or missing one re-bakes too) and glslangValidator's version
    # (it produces the SPIR-V this table is derived from). A SPIRV-Cross patch,
    # a spirv-tools bump or a glslang upgrade all move this Value and re-bake.
    # build-linux.sh used to force the same guarantee by deleting the header on
    # every run, which re-baked ~275 shader modules each time regardless.
    def _pipeline_fingerprint():
        parts = []
        for d in (
            "#thirdparty/spirv-cross-wgsl",
            "#thirdparty/spirv-tools",
            "#thirdparty/spirv-headers",
            "#drivers/webgpu/wgsl_cli",
        ):
            base = env.Dir(d).abspath
            for walk_root, walk_dirs, walk_files in os.walk(base):
                # Prune wgsl_cli/.build (the host tool's own object tree) and
                # __pycache__: the bake action rebuilds the host tool, which
                # rewrites those, which would move this fingerprint and re-bake
                # on the next run, forever.
                walk_dirs[:] = sorted(w for w in walk_dirs if not w.startswith(".") and w != "__pycache__")
                for name in sorted(walk_files):
                    full = os.path.join(walk_root, name)
                    try:
                        st = os.stat(full)
                    except OSError:
                        continue
                    parts.append(f"{os.path.relpath(full, base)}:{st.st_size}:{int(st.st_mtime)}")

        cli = env.File("#bin/wgsl_convert_cli" + (".exe" if os.name == "nt" else "")).abspath
        try:
            with open(cli, "rb") as f:
                parts.append("cli:" + hashlib.sha1(f.read()).hexdigest())
        except OSError:
            parts.append("cli:absent")

        glslang = env.get("GLSLANG", "glslangValidator")
        try:
            parts.append(
                "glslang:"
                + subprocess.run([glslang, "--version"], capture_output=True, text=True, timeout=30).stdout.strip()
            )
        except (OSError, subprocess.SubprocessError):
            parts.append("glslang:unknown")

        return hashlib.sha1("\n".join(parts).encode("utf-8")).hexdigest()

    env.Depends(precompiled, env.Value(_pipeline_fingerprint()))
else:
    # Native editor "shader baker" subset only (WEBGPU_SHADER_BAKER_ENABLED,
    # set by this platform's detect.py configure() when webgpu=yes tools=yes).
    # Just enough to bake SPIR-V → WGSL into RenderingShaderContainerWebGPU at
    # web-export time (see shader_baker_export_plugin_platform_webgpu.cpp) by
    # shelling out to bin/wgsl_convert_cli (wgsl_bake_subprocess.cpp)
    # — deliberately doesn't link the converter into the editor at all: a pass
    # or the converter can abort() on a shader variant it doesn't handle, and
    # baking eagerly compiles every declared variant (not just ones a game
    # actually exercises at runtime), so a subprocess boundary is needed to
    # keep one bad shader from taking down the whole editor. Also
    # deliberately excludes rendering_device_driver_webgpu.cpp /
    # rendering_context_driver_webgpu.cpp, which need Emscripten headers and a
    # real browser WebGPU device and can't compile natively.
    baker_sources = [
        "#drivers/webgpu/rendering_shader_container_webgpu.cpp",
        "#drivers/webgpu/wgsl_bake_subprocess.cpp",
        # Raw SPIR-V reflection the baker records into each container so the
        # runtime does not have to re-derive it (and, where it covers
        # everything the runtime needs, so the container can ship without the
        # SPIR-V at all). A plain instruction-stream walk with no SPIRV-Tools
        # dependency, which is what lets it be here -- see
        # spirv_lite_reflect.h's doc comment.
        "#drivers/webgpu/spirv_lite_reflect.cpp",
        # The WGSL text reads the runtime driver makes, shared so the baker's
        # "does this stage declare an override" test is the driver's own. Plain
        # std, no engine types.
        "#drivers/webgpu/wgsl_text_scan.cpp",
        # Needed to bake recorded specialization-constant variants at export
        # time (Task 13 Phase 2) -- pure SPIR-V byte patching + hashing, no
        # SPIRV-Tools/SPIRV-Cross dependency, so safe to add here unlike
        # spirv_preprocess.cpp (see spirv_spec_constants.h's doc comment).
        "#drivers/webgpu/spirv_spec_constants.cpp",
    ]
    env_webgpu.add_source_files(env.drivers_sources, baker_sources)

# Add thirdparty objects to the driver (empty lists on native "shader baker" builds).
env.drivers_sources += spirv_tools_obj
env.drivers_sources += spirv_cross_obj
