; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Default Folders Test"
config/features=PackedStringArray("4.8")

[editor]

script/default_script_folder="res://legacy_scripts"
default_folders/materials="res://materials"
default_folders/settings="res://settings"

[editor_plugins]

enabled=PackedStringArray("res://addons/default_folders_test/plugin.cfg")
