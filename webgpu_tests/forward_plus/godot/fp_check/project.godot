; Engine configuration file.
config_version=5

[application]

config/name="WebGPU Forward+ Feature Matrix"
config/description="One scene, driven from the URL hash, that turns each Forward+ feature on and off so the harness can prove the feature changes the frame."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="disabled"

[rendering]

; Forward+ is the whole point of this fixture. If the adapter cannot provide it
; the engine falls back to Forward Mobile silently, and run_forward_plus.mjs
; detects that from the startup banner and skips rather than reporting failures.
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="forward_plus"
; Everything that would smear the A/B comparison is off by default; the tests
; that exercise AA and scaling turn their own feature on explicitly.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/use_debanding=false
; Screen-space contact shadows are off by default engine-wide; the matrix
; toggles the per-light allow flag, so the feature must be enabled here or
; there is nothing for that toggle to switch.
lights_and_shadows/contact_shadow/enabled=true
