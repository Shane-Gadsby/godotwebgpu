; Engine configuration file.
config_version=5

[application]

config/name="WebGPU Volumetric Fog Check"
config/description="Fog-dominated scene whose froxel volume is sampled across most of the frame, so a loss of trilinear filtering shows as visible banding."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="forward_plus"
; The assertion measures high-frequency energy in the fog, so anything that
; blurs or resamples the frame would mask exactly the artifact being guarded.
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=false
; Left at the engine defaults (64) on purpose: this guards the shipped
; configuration, not a contrived one.
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
