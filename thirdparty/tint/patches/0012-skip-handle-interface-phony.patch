diff --git a/thirdparty/tint/src/tint/lang/spirv/reader/parser/parser.cc b/thirdparty/tint/src/tint/lang/spirv/reader/parser/parser.cc
index fd516686c7..60ff633584 100644
--- a/thirdparty/tint/src/tint/lang/spirv/reader/parser/parser.cc
+++ b/thirdparty/tint/src/tint/lang/spirv/reader/parser/parser.cc
@@ -276,6 +276,41 @@ class Parser {
             auto* func = *(functions_.Get(spv_id));
             for (uint32_t i = 3; i < entry_point.NumInOperands(); ++i) {
                 auto* val = Value(entry_point.GetSingleWordInOperand(i));
+                // GODOT WEBGPU PATCH: skip the phony reference for a
+                // Handle-address-space (sampler/texture/sampled-image)
+                // interface variable. This phony exists so the reader can't
+                // silently lose track of an interface-listed binding this
+                // entry point never actually reads in code -- necessary for
+                // Uniform/StorageBuffer/Private/Workgroup/Input/Output vars,
+                // where "unused but declared" is a real, valid state WGSL can
+                // represent (`_ = &(var);`). A Handle-typed resource has no
+                // such state: WGSL has no address-of for samplers/textures at
+                // all, so this phony can never be discharged into valid WGSL
+                // no matter what later lowering does with it -- patches
+                // 0008/0009's texture.cc/reader.cc defense-in-depth, added
+                // when this call site was believed unreachable, do not
+                // actually catch this: it still reaches the WGSL writer as
+                // `_ = &(var);` against a handle-typed global, which
+                // resolver.cc's own address-of-a-handle check then rejects.
+                // Godot's own preprocessing pipeline (eliminate_dead_resources,
+                // an AggressiveDCE pass run before Tint ever sees the module)
+                // already strips any resource this entry point doesn't
+                // genuinely reach in code, so by the time this runs, every
+                // Handle-typed interface variable left is real, used code --
+                // it needs no phony to stay "found," just like it needed none
+                // before SPIR-V 1.4 started listing it here at all. See
+                // webgpu_notes/TASKS.md Task 21 and thirdparty/README.md's
+                // `## tint` patch list.
+                //
+                // val here is an OpVariable's own result -- a pointer, not
+                // the handle type directly (Type::IsHandle() only matches
+                // the handle type itself, e.g. Sampler/Texture, not a
+                // Pointer wrapping one) -- so this checks the pointer's
+                // address space, not IsHandle() on val's type.
+                if (auto* ptr = val->Type()->As<core::type::Pointer>();
+                    ptr && ptr->AddressSpace() == core::AddressSpace::kHandle) {
+                    continue;
+                }
                 b_.Phony(val)->InsertBefore(func->Block()->Front());
             }
         }
