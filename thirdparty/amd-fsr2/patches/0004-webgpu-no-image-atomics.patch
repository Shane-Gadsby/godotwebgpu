 {
+#ifdef NO_IMAGE_ATOMICS
+	spdCounter = atomicAdd(rw_spd_global_atomic_value[0], 1);
+#else
 	spdCounter = imageAtomicAdd(rw_spd_global_atomic, ivec2(0,0), 1);
+#endif
